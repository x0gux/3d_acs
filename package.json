{
  "name": "axbis-acs-workspace",
  "private": true,
  "version": "0.1.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "dev": "pnpm --filter @axbis/demo dev",
    "build": "pnpm --filter @axbis/acs-core build && pnpm --filter @axbis/acs-react build && pnpm --filter @axbis/demo build",
    "typecheck": "pnpm --filter @axbis/acs-core build && pnpm -r typecheck",
    "pack:core": "pnpm --filter @axbis/acs-core build && pnpm --filter @axbis/acs-core pack",
    "pack:react": "pnpm run build && pnpm --filter @axbis/acs-react pack"
  }
}
